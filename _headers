/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; worker-src 'none'; upgrade-insecure-requests
/dashboard/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/login/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/portal/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/thank-you/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/pay/*
  X-Robots-Tag: noindex, follow
/templates/*
  X-Robots-Tag: noindex, follow
